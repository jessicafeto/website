# Production environment variables.
#
# Only NEXT_PUBLIC_* values belong here — they are inlined into the browser
# bundle at build time, so this file must NOT contain secrets. A Google
# Analytics Measurement ID is public by design (it's visible in page source),
# so it is safe to commit.
#
# Google Analytics 4. Loaded only AFTER a visitor consents to analytics
# cookies (see components/consent/ConsentScripts.tsx) — GDPR-compliant.
NEXT_PUBLIC_GA_ID=G-V6285T771L

# TinaCMS project (public Client ID). The read-only TINA_TOKEN is a secret and
# lives only in Netlify's environment variables, never in the repo.
NEXT_PUBLIC_TINA_CLIENT_ID=d19dcd70-73df-479b-b064-a9cca88614b4
